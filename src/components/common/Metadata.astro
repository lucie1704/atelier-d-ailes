---
import merge from 'lodash.merge';
import { SITE, METADATA } from 'astrowind:config';
import { getLocale, switchLocalePath, t } from '~/i18n';
import { LOCALES } from '~/constants/i18n';
import { getAbsoluteUrl, getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages } from '~/utils/images';
import type { Locale } from '~/i18n';
import type { MetaData, OpenGraph } from '~/types';

const locale = getLocale();
const ogLocales: Record<Locale, string> = { fr: 'fr_FR', en: 'en_US' };
const getAlternateHref = (locale: Locale) => getAbsoluteUrl(switchLocalePath(locale));

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

interface SeoProps {
  title?: string;
  titleTemplate?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  openGraph?: OpenGraph;
  twitter?: { cardType?: string; site?: string; handle?: string; image?: string };
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const seoProps: SeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: ogLocales[locale],
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);

const { titleTemplate, canonical: canonicalUrl, noindex, nofollow, twitter: twitterCard } = seoProps;
const pageTitle = seoProps.title;
const pageDescription = seoProps.description;
const robotsContent = [
  ...(typeof noindex !== 'undefined' ? [noindex ? 'noindex' : 'index'] : []),
  ...(typeof nofollow !== 'undefined' ? [nofollow ? 'nofollow' : 'follow'] : []),
].join(',');
const fullTitle = pageTitle && titleTemplate ? titleTemplate.replace('%s', pageTitle) : pageTitle;
const imageAlt = t('shareImage.alt');
const og = await adaptOpenGraphImages(seoProps.openGraph, Astro.site);
const twitterImage = twitterCard?.image
  ? (await adaptOpenGraphImages({ images: [{ url: twitterCard.image }] }, Astro.site)).images?.[0]?.url
  : undefined;
---

{fullTitle && <title>{fullTitle}</title>}
{pageDescription && <meta name="description" content={pageDescription} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

{(og.title || fullTitle) && <meta property="og:title" content={og.title || fullTitle} />}
{(og.description || pageDescription) && <meta property="og:description" content={og.description || pageDescription} />}
{og.url && <meta property="og:url" content={og.url} />}
{og.type && <meta property="og:type" content={og.type} />}
{og.images?.map((image) => (
  <>
    <meta property="og:image" content={image.url} />
    <meta property="og:image:alt" content={image.alt || imageAlt} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
  </>
))}
{og.locale && <meta property="og:locale" content={og.locale} />}
{LOCALES.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={ogLocales[l]} />
))}
{og.site_name && <meta property="og:site_name" content={og.site_name} />}

{twitterCard?.cardType && <meta name="twitter:card" content={twitterCard.cardType} />}
{twitterImage && <meta name="twitter:image" content={twitterImage} />}
{twitterImage && <meta name="twitter:image:alt" content={imageAlt} />}
{twitterCard?.site && <meta name="twitter:site" content={twitterCard.site} />}
{twitterCard?.handle && <meta name="twitter:creator" content={twitterCard.handle} />}

<link rel="alternate" hreflang="fr" href={getAlternateHref('fr')} />
<link rel="alternate" hreflang="en" href={getAlternateHref('en')} />
<link rel="alternate" hreflang="x-default" href={getAlternateHref('fr')} />
