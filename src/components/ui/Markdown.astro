---
import { renderMarkdown } from '~/utils/markdown';

interface Props {
  content: string;
  class?: string;
}

const { content, class: extraClass = '' } = Astro.props;

const html = renderMarkdown(content);
---

<div
  class={`prose prose-a:no-underline max-w-none prose-lg [&_p]:mt-4 prose-a:text-primary prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-img:rounded-md prose-img:shadow-lg [&_ul]:list-disc [&_ul]:pl-10 [&_ol]:list-decimal [&_ol]:pl-6 ${extraClass}`}
  set:html={html}
/>
